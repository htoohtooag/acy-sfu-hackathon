NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://user:password@pooler-host:6543/postgres?pgbouncer=true&sslmode=require&uselibpqcompat=true
DIRECT_URL=postgresql://user:password@direct-host:5432/postgres?sslmode=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_JWT_SECRET=replace-with-jwt-secret
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_GENERATION_MODEL=replace-with-configured-generation-model
GEMINI_EMBEDDING_MODEL=replace-with-configured-embedding-model
GEMINI_EMBEDDING_OUTPUT_DIMENSIONALITY=1536
AI_SEARCH_TIMEOUT_MS=30000
AI_SEARCH_MAX_MESSAGES=20
AI_SEARCH_MAX_USER_MESSAGE_CHARS=4000
AI_SEARCH_RATE_LIMIT_WINDOW_MS=60000
AI_SEARCH_RATE_LIMIT_MAX_REQUESTS=10
