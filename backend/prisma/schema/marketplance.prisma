// backend/prisma/schema/marketplace.prisma

model Package {
  id            String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  freelancer_id String                       @db.Uuid
  tier_id       String?                      @db.Uuid
  title         String                       @db.VarChar(255)
  description   String?
  price_mmk     BigInt
  delivery_days Int
  features      Json                         @default("[]")
  is_active     Boolean                      @default(true)
  embedding     Unsupported("vector(1536)")?
  created_at    DateTime                     @default(now()) @db.Timestamptz
  updated_at    DateTime                     @updatedAt @db.Timestamptz
  deleted_at    DateTime?                    @db.Timestamptz

  freelancer FreelancerProfile @relation(fields: [freelancer_id], references: [id], onDelete: Cascade)
  tier       PackageTier?      @relation(fields: [tier_id], references: [id])
  orders     Order[]
  media      PackageMedia[]

  @@index([freelancer_id], map: "idx_packages_freelancer")
  @@map("packages")
}

model PackageMedia {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  package_id String @db.Uuid
  type       String @db.VarChar(20) // "IMAGE" or "VIDEO"
  url        String // URL from Supabase Storage
  sort_order Int    @default(0) // To order them in the UI gallery

  package Package @relation(fields: [package_id], references: [id], onDelete: Cascade)

  @@index([package_id], map: "idx_package_media_package")
  @@map("package_media")
}

model JobPost {
  id                String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id         String                       @db.Uuid
  title             String                       @db.VarChar(255)
  description       String
  budget_min_mmk    BigInt?
  budget_max_mmk    BigInt?
  expected_deadline DateTime?                    @db.Date
  status            job_status                   @default(OPEN)
  embedding         Unsupported("vector(1536)")?
  created_at        DateTime                     @default(now()) @db.Timestamptz
  updated_at        DateTime                     @updatedAt @db.Timestamptz
  deleted_at        DateTime?                    @db.Timestamptz

  client ClientProfile @relation(fields: [client_id], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([client_id], map: "idx_jobposts_client")
  @@index([status], map: "idx_jobposts_status")
  @@map("job_posts")
}
